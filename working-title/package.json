{
  "name": "working-title",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "@babylonjs/havok": "1.3.14"
  },
  "devDependencies": {
    "@babylonjs/inspector": "9.29.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/emscripten": "1.41.6",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
